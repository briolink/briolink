# Build worker (issue #4): one offline container per task.
# Base pinned by digest (E1); its Go version must match go.mod's toolchain
# line exactly, so a drift fails fast on GOTOOLCHAIN=local instead of
# depending on network failure behaviour.
FROM golang@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61
ENV GOTOOLCHAIN=local
WORKDIR /workspace
