# The hub's firewall for the private network (A21, #49). Loaded by
# ops/wg-hub-fw-install.sh. Only wg0 traffic is touched; everything else on the
# tower passes untouched (policy accept, rules match iifname "wg0" only).
#
#   Founder devices 10.88.0.100-119 -> servers 10.88.0.10-49: SSH
#   Founder devices                 -> hub 10.88.0.1:       SSH, 443
#   Servers -> hub (replica endpoint, metrics): ports not defined yet, so
#   dropped until A21 names them.
#   Everything else from wg0 is dropped (server -> device, server -> server,
#   device -> device, any other port).
table inet briolink_hub
delete table inet briolink_hub

table inet briolink_hub {
  set founder_devices { type ipv4_addr; flags interval; elements = { 10.88.0.100-10.88.0.119 } }
  set server_peers { type ipv4_addr; flags interval; elements = { 10.88.0.10-10.88.0.49 } }

  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "wg0" ct state established,related counter accept
    iifname "wg0" ip saddr @founder_devices ip daddr @server_peers tcp dport 22 ct state new counter accept
    iifname "wg0" counter drop
    oifname "wg0" ct state established,related accept
    oifname "wg0" counter drop
  }

  chain input {
    type filter hook input priority filter; policy accept;
    iifname "wg0" ct state established,related accept
    iifname "wg0" ip saddr @founder_devices tcp dport { 22, 443 } ct state new counter accept
    iifname "wg0" counter drop
  }
}
