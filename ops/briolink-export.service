# Exports issues (code host fallback, #62). Run by
# briolink-export.timer; installed by ops/mirror-export-install.sh.
[Unit]
Description=Briolink nightly issue export
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=MIRROR_ENV_FILE=@ENV_FILE@
Environment=MIRROR_DATA=/var/lib/briolink-mirror
ExecStart=/usr/local/sbin/briolink-mirror-export.sh export
