     "context": "acme", "call": "Invoice.issue", "status": 200,
     "request": [{"name": "id", "in": "path", "type": "string", "min": null, "max": null, "pattern": "", "doc": ""}],
     "response": [{"name": "invoice", "type": "Invoice", "doc": ""}]},
    {"name": "record_payment", "method": "POST", "path": "/invoices/{id}/payments", "role": "member",
