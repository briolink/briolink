       {"name": "reason", "in": "body", "type": "string", "min": 1, "max": 500, "pattern": "", "doc": ""}
     ],
     "response": []},
    {"name": "invoice_total", "method": "GET", "path": "/invoices/{id}/total", "role": "member",
     "context": "acme", "call": "total", "status": 200,
     "request": [{"name": "id", "in": "path", "type": "string", "min": null, "max": null, "pattern": "", "doc": ""}],
     "response": [{"name": "total", "type": "int", "doc": "Cents"}]}
  ]
