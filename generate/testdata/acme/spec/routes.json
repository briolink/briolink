       {"name": "id", "in": "path", "type": "string", "min": null, "max": null, "pattern": "", "doc": ""},
       {"name": "amount", "in": "body", "type": "int", "min": 1, "max": null, "pattern": "", "doc": "Cents"}
     ],
     "response": [{"name": "invoice", "type": "Invoice", "doc": ""}]},
    {"name": "void_invoice", "method": "POST", "path": "/invoices/{id}/void", "role": "member",
