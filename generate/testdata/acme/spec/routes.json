       {"name": "customer", "in": "body", "type": "string", "min": 1, "max": 200, "pattern": "", "doc": ""},
       {"name": "currency", "in": "body", "type": "Currency", "min": null, "max": null, "pattern": "", "doc": ""}
     ],
     "response": [{"name": "invoice", "type": "Invoice", "doc": ""}]},
    {"name": "add_line", "method": "POST", "path": "/invoices/{id}/lines", "role": "member",
     "context": "acme", "call": "Invoice.add_line", "status": 200,
     "request": [
       {"name": "id", "in": "path", "type": "string", "min": null, "max": null, "pattern": "^[a-z0-9-]{1,40}$", "doc": ""},
       {"name": "line", "in": "body", "type": "Line", "min": null, "max": null, "pattern": "", "doc": ""}
     ],
     "response": [{"name": "invoice", "type": "Invoice", "doc": ""}]},
